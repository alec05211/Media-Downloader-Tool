{
  "manifest_version": 3,
  "name": "Media Downloader Launcher",
  "version": "1.3.0",
  "description": "Open supported images, videos, audio, and links in the local Media Downloader app.",
  "key": "",
  "permissions": ["activeTab", "clipboardWrite", "contextMenus", "nativeMessaging", "scripting"],
  "host_permissions": ["http://127.0.0.1:38471/*"],
  "action": {
    "default_title": "Open Media Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
